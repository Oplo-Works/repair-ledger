# Copy to .env.local (never commit .env.local). Web firebaseConfig values are not secrets,
# but we keep them out of the repo until the project is created.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check reCAPTCHA v3 SITE key (public). Never put the secret key here.
VITE_RECAPTCHA_SITE_KEY=
# Localhost only: set to "true" in .env.local to use App Check debug provider locally.
# Never commit a debug token. Never enable this in a production build.
VITE_APPCHECK_DEBUG=
# Explicit cloud model (do not rely on the SDK default lightweight model).
VITE_CLOUD_MODEL=gemini-3.8-flash
